{
  "name": "@sheetcn/react",
  "version": "0.0.0",
  "description": "React binding for sheetcn: useSheet wires the core store to TanStack Table cell selection and TanStack Virtual, with the keyboard map, editing, pointer selection and views that filter, sort and group.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fredehagelund92/sheetcn.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@sheetcn/core": "workspace:*",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
